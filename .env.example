# Set this to the final custom site's HTTPS origin before deploying.
# Leave unset while developing: indexing stays disabled and no canonical is invented.
SITE_URL=

# Candidate origins: https://yeshuaobi.com or https://thecreativenomad.com.
# Choose/purchase the final domain before enabling production indexing.
# Optional Google Search Console HTML verification value, issued for your property.
GOOGLE_SITE_VERIFICATION=

{
  "name": "yeshua-obi-portfolio-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "typecheck": "tsc --noEmit",
    "test": "node --test migration.test.mjs",

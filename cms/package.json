{
  "name": "yeshua-obi-portfolio-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build && node prepare-hosting.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test migration.test.mjs",
    "deploy": "node deploy.mjs",
    "import:check": "node import-content.mjs --dry-run",
    "import:content": "node --env-file-if-exists=.env.local import-content.mjs --apply"
  },
  "dependencies": {
    "@sanity/client": "8.11.0",
    "@sanity/orderable-document-list": "2.0.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "6.20.0",
    "styled-components": "6.1.19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}

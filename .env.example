# Set this to the final custom site's HTTPS origin before deploying.
# Leave unset while developing: indexing stays disabled and no canonical is invented.
SITE_URL=

# Selected final origin: https://yeshuaobi.com.
# Register and connect the domain before enabling production indexing.
# Optional Google Search Console HTML verification value, issued for your property.
GOOGLE_SITE_VERIFICATION=

# Enable only after the published portfolio documents are imported and verified.
# Public content reads need no API token. The intended project is dntp46vk/production.
SANITY_PROJECT_ID=
SANITY_DATASET=
